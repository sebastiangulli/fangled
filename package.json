    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cf": "^1.0.0-beta.31",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  }
